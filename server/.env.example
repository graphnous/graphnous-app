# Copy to .env next to docker-compose.yml and fill in

# Required: the password of the Neo4j instance the compose file starts
NEO4J_PASSWORD=

# Required: the password of the PostgreSQL instance the compose file starts.
# The database and user default to graphnous.
POSTGRES_PASSWORD=
# POSTGRES_DB=
# POSTGRES_USER=

# The group that owns the Docker socket; leave unset on Docker Desktop.
# On Linux: stat -c %g /var/run/docker.sock
# DOCKER_GID=
